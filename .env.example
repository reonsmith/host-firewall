# Required. Generate the secret with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
HOST_FIREWALL_PASSWORD=change-me-min-12-chars
HOST_FIREWALL_SECRET_KEY=change-me-to-a-random-32plus-byte-secret

# Shown in the header and page title.
HOST_FIREWALL_LABEL=host

# Where the panel listens. The container uses host networking, so this is a
# host address. Keep it off the public internet:
#   127.0.0.1      only a reverse proxy on the same host can reach it (recommended)
#   192.168.x.y    a LAN / management VLAN address
#   0.0.0.0        every interface (the built-in default; avoid)
HOST_FIREWALL_BIND=127.0.0.1
HOST_FIREWALL_PORT=8080

# Seconds to confirm a change before it rolls back.
HOST_FIREWALL_CONFIRM_SECONDS=60

# Session cookie Secure flag: auto (Secure when the request arrived over HTTPS,
# including via X-Forwarded-Proto from your proxy), true, or false.
# HOST_FIREWALL_COOKIE_SECURE=auto
